<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<body>
    <% if(msg) { %>
        <p><%= msg %></p>
    <% } %>
    <h1>Login</h1>
    <form method="post" action="http://localhost:3000/login<%= `?original=${actualPath}` %>">
        Username: <input type="text" name="username">
        Password: <input type="password" name="password">
        <button>Login</button>
    </form>
</body>
</html>